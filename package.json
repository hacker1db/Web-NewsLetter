{
	"name": "hacker1db-newsletter",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:migrate": "node scripts/migrate.mjs",
		"test": "vitest run --config vitest.config.ts",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"mcp:playwright": "node scripts/playwright-mcp.mjs",
		"test:mcp": "node scripts/mcp-smoke.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/mcp": "^0.0.83",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-vercel": "^5.7.3",
		"@sveltejs/kit": "^2.21.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.8",
		"@types/node": "^22.20.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.33.12",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.1.8",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^6.3.5",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.2.0",
		"@workos/authkit-sveltekit": "^0.3.0",
		"resend": "^4.0.0"
	},
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"browser-tabs-lock",
			"core-js",
			"esbuild"
		]
	}
}
