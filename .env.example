# Email
RESEND_API_KEY=re_...

# Database (Neon Postgres provisioned through the Vercel Marketplace)
DATABASE_URL=postgresql://...
# Long random secret used to sign subscriber links. Do not change it after subscribers exist.
SUBSCRIBER_TOKEN_SECRET=...

# WorkOS AuthKit (server-only; never use a VITE_ prefix)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback/
# Comma-separated WorkOS user IDs; missing/empty denies admin access.
ADMIN_USER_IDS=

# Public URLs
PUBLIC_BLOG_URL=https://hacker1db.dev
PUBLIC_SITE_URL=https://newsletter.hacker1db.dev
