# Email
RESEND_API_KEY=re_...

# Database (Neon Postgres provisioned through the Vercel Marketplace)
DATABASE_URL=postgresql://...
# Long random secret used to sign subscriber links. Do not change it after subscribers exist.
SUBSCRIBER_TOKEN_SECRET=...

# Clerk auth (publishable key must be VITE_ prefixed for client-side access)
VITE_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Also signs server admin sessions; Clerk session status is checked on every request.
# Rotating this key invalidates existing admin cookies. Admin cookies expire after 8 hours.
# Comma-separated Clerk user IDs. Missing/empty denies all admin access.
ADMIN_USER_IDS=
# Exact frontend origins; add a localhost origin explicitly for local login.
CLERK_AUTHORIZED_PARTIES=https://newsletter.hacker1db.dev
# Optional Clerk PEM public key for networkless verification (otherwise uses secret-key JWKS).
CLERK_JWT_KEY=

# Public URLs
PUBLIC_BLOG_URL=https://hacker1db.dev
PUBLIC_SITE_URL=https://newsletter.hacker1db.dev
